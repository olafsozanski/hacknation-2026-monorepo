# Copy to .env and fill in. Never commit the real .env file.
# Use long, unique passwords — the application refuses the example values from the documentation.
POSTGRES_PASSWORD=
ADMIN_PASSWORD=

# Demo data (10 sample requests + archive). Keep false in production.
DEMO_DATA=false
DEMO_PASSWORD=

# AI is disabled unless one of the two options below is configured.
#
# Prototype only: external OpenAI API. Request texts and drafts (with personal data) leave the
# city hall network, so this must be enabled explicitly and used with test data only.
# AI_PROVIDER=OpenAI
# AI_API_KEY=
# AI_CHAT_MODEL=gpt-5-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_ALLOW_EXTERNAL_PROCESSING=true
#
# Target: local model via Ollama (start with: docker compose --profile local-ai up -d).
# The endpoint must be internal (service name, private IP or .local/.internal host).
# AI_PROVIDER=Ollama
# AI_ENDPOINT=http://ollama:11434/v1
# AI_CHAT_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M   # Polish LLM; check the current tag on ollama.com
# AI_EMBEDDING_MODEL=bge-m3
# AI_IS_LOCAL=true
#
# In-app assistant: with tools it looks up cases, the archive and departments itself and proposes
# actions that the clerk confirms. Set AI_ASSISTANT_TOOLS=false for local models without tool calling
# (e.g. Bielik); the assistant then answers from injected context only and proposes no actions.
AI_ASSISTANT_TOOLS=true
# Reasoning effort sent with the assistant's tool calls (None, Low, Medium, High, ExtraHigh); empty = model default.
# Some OpenAI reasoning models reject tools in Chat Completions unless this is None.
AI_ASSISTANT_REASONING_EFFORT=
# Days after which assistant conversations are deleted.
ASSISTANT_RETENTION_DAYS=30

# Network exposure. Plain HTTP is acceptable only on loopback (APP_BIND=127.0.0.1).
# For access from other computers run an HTTPS reverse proxy (IIS, nginx) on the same host, keep
# APP_BIND=127.0.0.1, and set REQUIRE_HTTPS=true and TRUST_FORWARDED_HEADERS=true. KNOWN_PROXY must be the
# address the proxy connects from as seen by the container (for a proxy on the Docker host usually the
# docker bridge gateway, e.g. 172.17.0.1).
APP_BIND=127.0.0.1
APP_PORT=8080
REQUIRE_HTTPS=false
TRUST_FORWARDED_HEADERS=false
KNOWN_PROXY=127.0.0.1
