# Copy to .env and fill in. Never commit the real .env file.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
ADMIN_PASSWORD=ChangeMe12345

# Demo data (10 sample requests + archive). Keep false in production.
DEMO_DATA=false
DEMO_PASSWORD=

# Prototype: OpenAI (data leaves the network — use only with test data)
AI_PROVIDER=OpenAI
AI_API_KEY=
AI_CHAT_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_IS_LOCAL=false

# Target: local model via Ollama (start with: docker compose --profile local-ai up -d)
# AI_PROVIDER=Ollama
# AI_ENDPOINT=http://ollama:11434/v1
# AI_CHAT_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M   # Polish LLM; check the current tag on ollama.com
# AI_EMBEDDING_MODEL=bge-m3
# AI_IS_LOCAL=true

# Network exposure: 127.0.0.1 = this machine only (plain HTTP is acceptable only on loopback).
# For access from other computers put the app behind an HTTPS reverse proxy (IIS, nginx) and set
# APP_BIND=0.0.0.0, REQUIRE_HTTPS=true and TRUST_FORWARDED_HEADERS=true (only if the app is reachable solely via the proxy).
APP_BIND=127.0.0.1
APP_PORT=8080
REQUIRE_HTTPS=false
TRUST_FORWARDED_HEADERS=false
